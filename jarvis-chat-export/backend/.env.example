PORT=3100
ALLOWED_ORIGIN=*

# ── Modelo local (llama.cpp / llama-server) ──
# O Jarvis e 100% offline: o unico provedor e o modelo local. Sem llama-server
# de pe, o chat responde 503 — nao existe fallback de nuvem, de proposito.
# Runtime: brew install llama.cpp
# Modelo:  qualquer GGUF instruct. Em maquina de 8 GB, um 3B quantizado (q4_k_m).
# Suba com: npm run modelo
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=local
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_GGUF=/caminho/para/modelo.gguf

# ── Espaco de arquivos ──
# Unica pasta em que o Jarvis pode criar, editar e apagar arquivos. Tudo que o
# modelo propuser fora daqui e recusado. Aceita ~.
# Padrao: ~/Jarvis-Arquivos (criada sozinha ao subir o servidor).
# NAO aponte para ~/Dev nem para o vault: o modelo e um 3B e erra caminho.
JARVIS_ARQUIVOS_RAIZ=~/Jarvis-Arquivos

# ── Modo documentos (RAG offline) ──
# Pastas com .md para indexar (vault do Obsidian, docs dos projetos...),
# separadas por dois-pontos. Depois: npm run indexar
# O indice fica em data/indice-rag.json, fora do versionamento.
RAG_FONTES=/caminho/para/vault:/outro/caminho
