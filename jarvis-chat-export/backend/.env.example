PORT=3000
AGENT_ROUTING_STRATEGY=auto
ALLOWED_ORIGIN=*

GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Persistencia de logs em producao (Vercel + Neon/Supabase)
# Use DATABASE_URL ou POSTGRES_URL.
DATABASE_URL=
# POSTGRES_URL=

# Logs em tempo real via HTTP ingest (modo principal)
LOG_INGEST_ENABLED=true
LOG_INGEST_API_TOKEN=
# Opcional: caminho customizado do banco SQLite
# LOG_DB_FILE=C:\\jarvis-data\\jarvis-logs.db
LOG_INGEST_MAX_CONTEXT_EVENTS=60

# Logs historicos / fallback: Google Drive
GOOGLE_DRIVE_FOLDER_ID=1B3Hv1fTVAnU4MV2aYfiMqPT1BFq7pire
GOOGLE_DRIVE_LOG_FOLDER_NAME=Log
# JSON completo da Service Account em uma linha
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternativa sem Service Account (OAuth de usuario)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost

# Logs: fallback local (Google Drive Desktop sincronizado)
# Exemplo Windows:
# LOG_LOCAL_DIR=C:\\Users\\SeuUsuario\\Google Drive\\Automacoes\\logs
LOG_LOCAL_DIR=

LOG_CONTEXT_MAX_FILES=12
LOG_CONTEXT_MAX_BYTES_PER_FILE=60000
LOG_CONTEXT_MAX_CHARS=18000

GROQ_MODEL_1=llama-3.3-70b-versatile
GROQ_MODEL_2=llama-3.1-8b-instant
